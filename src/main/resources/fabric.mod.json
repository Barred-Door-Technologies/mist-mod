{
	"schemaVersion": 1,
	"id": "mistsmp",
	"version": "${version}",
	"name": "Mist SMP",
	"description": "Client companion for the Mist SMP server. Renders cosmetics. Does nothing on other servers.",
	"authors": [
		"Barred Door Technologies"
	],
	"contact": {
		"homepage": "https://mistsmp.org",
		"sources": "https://github.com/Barred-Door-Technologies/mist-mod"
	},
  "license": "LicenseRef-All-Rights-Reserved",
  "environment": "client",
	"entrypoints": {
		"client": [
			"com.mistsmp.mod.client.MistModClient"
		]
	},
  "mixins": [
    {
      "config": "mistsmp.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
