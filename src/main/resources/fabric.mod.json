	"entrypoints": {
		"client": [
			"com.mistsmp.mod.client.MistModClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
